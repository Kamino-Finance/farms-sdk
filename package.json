{
  "name": "@kamino-finance/farms-sdk",
  "description": "Farms SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "files": [
    "dist",
    "src/**/*.ts"
  ],
  "version": "4.0.0",
  "scripts": {
    "build": "yarn tsc -b tsconfig.json --verbose",
    "build:test": "yarn tsc --project ./tests/tsconfig.json",
    "build:watch": "yarn tsc -w",
    "cli": "yarn tsx ../farms-cli/src/client.ts",
    "test": "yarn build:test && yarn ts-mocha tests/**/*.test.ts --exit",
    "codegen": "node codegen.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kamino-Finance/farms-sdk.git"
  },
  "keywords": [
    "kamino",
    "kamino-finance",
    "common",
    "sdk",
    "client",
    "kamino",
    "farms"
  ],
  "author": "Kamino Finance",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/kamino-Finance/farms-sdk/issues"
  },
  "homepage": "https://github.com/Kamino-Finance/kfarms",
  "dependencies": {
    "@kamino-finance/kliquidity-sdk": "^15.0.0",
    "@kamino-finance/scope-sdk": "^12.0.0",
    "@solana-program/address-lookup-table": "^0.13.0",
    "@solana-program/compute-budget": "^0.17.0",
    "@solana-program/system": "^0.13.0",
    "@solana-program/token": "^0.15.0",
    "@solana-program/token-2022": "^0.13.0",
    "@solana/kit": "^7.0.0",
    "@solana/sysvars": "^7.0.0",
    "decimal.js": "^10.4.3",
    "exponential-backoff": "^3.1.3"
  },
  "devDependencies": {
    "@ast-grep/napi": "^0.36.2",
    "@codama/nodes-from-anchor": "^1.3.9",
    "@codama/renderers-js": "^1.7.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.10",
    "chai": "^4.3.7",
    "codama": "^1.5.1",
    "mocha": "^10.2.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
